<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ================================================ -->
    <!-- CHANGESET 1: Create audit schema                 -->
    <!-- ================================================ -->
    <changeSet id="001-00-criar-schema-auditoria" author="hospitalao">
        <sql>CREATE SCHEMA IF NOT EXISTS auditoria;</sql>
        <rollback>
            <sql>DROP SCHEMA IF EXISTS auditoria CASCADE;</sql>
        </rollback>
    </changeSet>


    <!-- ================================================ -->
    <!-- CHANGESET 2: Global enums                        -->
    <!-- ================================================ -->
    <changeSet id="001-01-tipos-enum" author="hospitalao">

        <!-- Gender enum -->
        <sql>
            DO $$ BEGIN
                CREATE TYPE gender_enum AS ENUM ('MALE', 'FEMALE');
            EXCEPTION
                WHEN duplicate_object THEN NULL;
            END $$;
        </sql>

        <!-- Register status enum — used in users table -->
        <sql>
            DO $$ BEGIN
                CREATE TYPE register_status_enum AS ENUM (
                    'ACTIVE',
                    'INACTIVE',
                    'SUSPENDED'
                );
            EXCEPTION
                WHEN duplicate_object THEN NULL;
            END $$;
        </sql>

        <!-- Episode type enum — used in episodes table (future sprint) -->
        <sql>
            DO $$ BEGIN
                CREATE TYPE episode_type_enum AS ENUM (
                    'EMERGENCY',
                    'OUTPATIENT',
                    'INPATIENT',
                    'OUTPATIENT_SURGERY',
                    'EXAM'
                );
            EXCEPTION
                WHEN duplicate_object THEN NULL;
            END $$;
        </sql>

        <rollback>
            <sql>
                DROP TYPE IF EXISTS episode_type_enum;
                DROP TYPE IF EXISTS register_status_enum;
                DROP TYPE IF EXISTS gender_enum;
            </sql>
        </rollback>
    </changeSet>


    <!-- ================================================ -->
    <!-- CHANGESET 3: Audit log table                     -->
    <!-- ================================================ -->
    <changeSet id="001-02-tabela-auditoria" author="hospitalao">

        <createTable tableName="audit_log" schemaName="auditoria">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="true"/>
            </column>
            <column name="user_name" type="VARCHAR(200)">
                <constraints nullable="true"/>
            </column>
            <column name="table_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="record_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="operation" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="previous_data" type="JSONB">
                <constraints nullable="true"/>
            </column>
            <column name="new_data" type="JSONB">
                <constraints nullable="true"/>
            </column>
            <column name="origin_ip" type="VARCHAR(45)">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="audit_log"
                     schemaName="auditoria"
                     indexName="idx_audit_table_record">
            <column name="table_name"/>
            <column name="record_id"/>
        </createIndex>

        <createIndex tableName="audit_log"
                     schemaName="auditoria"
                     indexName="idx_audit_created_at">
            <column name="created_at"/>
        </createIndex>

        <rollback>
            <dropTable tableName="audit_log" schemaName="auditoria"/>
        </rollback>
    </changeSet>

</databaseChangeLog>