<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ================================================ -->
    <!-- CHANGESET 1: Patients table                      -->
    <!-- ================================================ -->
    <changeSet id="004-01-criar-tabela-patients" author="hospitalao">

        <createTable tableName="patients">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <!-- Personal info -->
            <column name="full_name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="birth_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="gender" type="gender_enum">
                <constraints nullable="false"/>
            </column>
            <column name="national_id" type="VARCHAR(20)">
                <constraints nullable="true" unique="true"
                             uniqueConstraintName="uq_patients_national_id"/>
            </column>
            <column name="health_card_number" type="VARCHAR(30)">
                <constraints nullable="true" unique="true"
                             uniqueConstraintName="uq_patients_health_card"/>
            </column>

            <!-- Contact -->
            <column name="phone" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
            <column name="email" type="VARCHAR(200)">
                <constraints nullable="true"/>
            </column>
            <column name="address" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>
            <column name="province" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="municipality" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>

            <!-- Emergency contact -->
            <column name="emergency_contact_name" type="VARCHAR(200)">
                <constraints nullable="true"/>
            </column>
            <column name="emergency_contact_phone" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
            <column name="emergency_contact_relationship" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>

            <!-- Clinical info -->
            <column name="blood_type" type="VARCHAR(5)">
                <constraints nullable="true"/>
            </column>
            <column name="allergies" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="chronic_conditions" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="notes" type="TEXT">
                <constraints nullable="true"/>
            </column>

            <!-- Status -->
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <!-- Audit -->
            <column name="created_by" type="UUID">
                <constraints nullable="true"
                             foreignKeyName="fk_patients_created_by"
                             references="users(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Indexes for common searches -->
        <createIndex tableName="patients" indexName="idx_patients_full_name">
            <column name="full_name"/>
        </createIndex>
        <createIndex tableName="patients" indexName="idx_patients_national_id">
            <column name="national_id"/>
        </createIndex>
        <createIndex tableName="patients" indexName="idx_patients_active">
            <column name="active"/>
        </createIndex>

        <rollback>
            <dropTable tableName="patients"/>
        </rollback>
    </changeSet>

</databaseChangeLog>