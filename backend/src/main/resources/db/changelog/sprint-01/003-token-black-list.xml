<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
        Tabela de blacklist de tokens JWT.
        Quando um utilizador faz logout, o token é guardado aqui
        até expirar naturalmente. O JwtAuthFilter verifica esta
        tabela em cada pedido autenticado.
    -->
    <changeSet id="003-01-criar-tabela-token-blacklist" author="hospitalao">

        <createTable tableName="token_blacklist">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <!-- O token JWT completo — máximo 500 chars é suficiente -->
            <column name="token" type="VARCHAR(500)">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uq_token_blacklist_token"/>
            </column>

            <!-- Data de expiração — usada para limpeza automática -->
            <column name="expiry_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Índice para pesquisa rápida por token (verificação em cada pedido) -->
        <createIndex tableName="token_blacklist"
                     indexName="idx_token_blacklist_token">
            <column name="token"/>
        </createIndex>

        <!-- Índice para limpeza de tokens expirados (tarefa agendada) -->
        <createIndex tableName="token_blacklist"
                     indexName="idx_token_blacklist_expiry">
            <column name="expiry_date"/>
        </createIndex>

        <rollback>
            <dropTable tableName="token_blacklist"/>
        </rollback>
    </changeSet>

</databaseChangeLog>