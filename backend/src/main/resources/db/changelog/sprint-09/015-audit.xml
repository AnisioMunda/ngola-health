<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ================================================ -->
    <!-- CHANGESET 1: Tabela de logs de auditoria         -->
    <!-- ================================================ -->
    <changeSet id="015-01-audit-logs" author="hospitalao">
        <createTable tableName="audit_logs">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="hospital_id" type="UUID">
                <constraints nullable="true"
                             foreignKeyName="fk_audit_hospital"
                             references="hospitals(id)"/>
            </column>
            <!-- Utilizador que realizou a acção -->
            <column name="user_id" type="UUID">
                <constraints nullable="true"
                             foreignKeyName="fk_audit_user"
                             references="users(id)"/>
            </column>
            <column name="username" type="VARCHAR(100)"/>
            <column name="user_full_name" type="VARCHAR(200)"/>
            <!--
                Acção realizada:
                CREATE, READ, UPDATE, DELETE,
                LOGIN, LOGOUT, LOGIN_FAILED,
                EXPORT, PRINT, APPROVE, REJECT
            -->
            <column name="action" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <!--
                Módulo/entidade afectada:
                PATIENT, EPISODE, LAB_REQUEST, MEDICATION,
                INVOICE, APPOINTMENT, ADMISSION, USER,
                NOTIFICATION, REPORT
            -->
            <column name="entity_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <!-- UUID da entidade afectada -->
            <column name="entity_id" type="VARCHAR(100)"/>
            <!-- Descrição legível da acção -->
            <column name="description" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <!-- Dados anteriores (para UPDATE/DELETE) em JSON -->
            <column name="old_values" type="TEXT"/>
            <!-- Dados novos (para CREATE/UPDATE) em JSON -->
            <column name="new_values" type="TEXT"/>
            <!-- Informação da sessão -->
            <column name="ip_address" type="VARCHAR(45)"/>
            <column name="user_agent" type="VARCHAR(500)"/>
            <column name="http_method" type="VARCHAR(10)"/>
            <column name="request_url" type="VARCHAR(500)"/>
            <!--
                Resultado da acção:
                SUCCESS, FAILURE, UNAUTHORIZED
            -->
            <column name="result" type="VARCHAR(15)" defaultValue="SUCCESS">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="VARCHAR(500)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Índices para pesquisa eficiente -->
        <createIndex tableName="audit_logs" indexName="idx_audit_hospital_date">
            <column name="hospital_id"/>
            <column name="created_at"/>
        </createIndex>
        <createIndex tableName="audit_logs" indexName="idx_audit_user">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="audit_logs" indexName="idx_audit_entity">
            <column name="entity_type"/>
            <column name="entity_id"/>
        </createIndex>
        <createIndex tableName="audit_logs" indexName="idx_audit_action">
            <column name="action"/>
        </createIndex>
        <createIndex tableName="audit_logs" indexName="idx_audit_created_at">
            <column name="created_at"/>
        </createIndex>

        <rollback><dropTable tableName="audit_logs"/></rollback>
    </changeSet>

</databaseChangeLog>