<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ================================================ -->
    <!-- CHANGESET 1: Tabela hospitals                    -->
    <!-- ================================================ -->
    <changeSet id="007-01-criar-tabela-hospitals" author="hospitalao">
        <createTable tableName="hospitals">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(20)">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uq_hospitals_code"/>
            </column>
            <column name="type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="province" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="municipality" type="VARCHAR(100)"/>
            <column name="address" type="VARCHAR(500)"/>
            <column name="phone" type="VARCHAR(20)"/>
            <column name="email" type="VARCHAR(200)"/>
            <column name="tax_id" type="VARCHAR(50)" remarks="NIF para AGT"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Hospital padrão para dados existentes -->
        <insert tableName="hospitals">
            <column name="id" value="00000000-0000-0000-0000-000000000100"/>
            <column name="name" value="Hospital Central de Luanda"/>
            <column name="code" value="HCL-001"/>
            <column name="type" value="HOSPITAL"/>
            <column name="province" value="Luanda"/>
            <column name="municipality" value="Ingombota"/>
            <column name="active" valueBoolean="true"/>
        </insert>

        <rollback>
            <dropTable tableName="hospitals"/>
        </rollback>
    </changeSet>

    <!-- ================================================ -->
    <!-- CHANGESET 2: Adicionar hospital_id às tabelas    -->
    <!-- ================================================ -->
    <changeSet id="007-02-adicionar-hospital-id" author="hospitalao">

        <addColumn tableName="users">
            <column name="hospital_id" type="UUID"/>
        </addColumn>

        <addColumn tableName="patients">
            <column name="hospital_id" type="UUID"/>
        </addColumn>

        <addColumn tableName="episodes">
            <column name="hospital_id" type="UUID"/>
        </addColumn>

        <update tableName="users">
            <column name="hospital_id"
                    value="00000000-0000-0000-0000-000000000100"/>
        </update>

        <update tableName="patients">
            <column name="hospital_id"
                    value="00000000-0000-0000-0000-000000000100"/>
        </update>

        <update tableName="episodes">
            <column name="hospital_id"
                    value="00000000-0000-0000-0000-000000000100"/>
        </update>

        <addForeignKeyConstraint
                baseTableName="users"
                baseColumnNames="hospital_id"
                referencedTableName="hospitals"
                referencedColumnNames="id"
                constraintName="fk_users_hospital"/>

        <addForeignKeyConstraint
                baseTableName="patients"
                baseColumnNames="hospital_id"
                referencedTableName="hospitals"
                referencedColumnNames="id"
                constraintName="fk_patients_hospital"/>

        <addForeignKeyConstraint
                baseTableName="episodes"
                baseColumnNames="hospital_id"
                referencedTableName="hospitals"
                referencedColumnNames="id"
                constraintName="fk_episodes_hospital"/>

    </changeSet>

</databaseChangeLog>