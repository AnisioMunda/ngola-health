<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
        Adicionar campos de integração AGT à tabela invoices.
        Campos necessários para o fluxo assíncrono da API AGT Angola:
        - agt_request_id    : requestID devolvido pela AGT após submissão
        - agt_status        : PENDING / ACEITE / REJEITADO
        - agt_validation_code: código de validação da AGT (após ACEITE)
        - agt_qr_code       : dados para o QR Code obrigatório no documento
        - agt_error_message : mensagem de erro em caso de REJEITADO
        - agt_submitted_at  : data/hora da submissão à AGT
    -->
    <changeSet id="011-01-agt-campos-invoice" author="hospitalao">

        <addColumn tableName="invoices">
            <column name="agt_request_id" type="VARCHAR(100)"
                    remarks="requestID devolvido pela API AGT após submissão"/>
        </addColumn>

        <addColumn tableName="invoices">
            <column name="agt_status" type="VARCHAR(20)" defaultValue="NAO_SUBMETIDO"
                    remarks="Estado AGT: NAO_SUBMETIDO, PENDING, ACEITE, REJEITADO"/>
        </addColumn>

        <addColumn tableName="invoices">
            <column name="agt_validation_code" type="VARCHAR(100)"
                    remarks="Código de validação atribuído pela AGT (após ACEITE)"/>
        </addColumn>

        <addColumn tableName="invoices">
            <column name="agt_qr_code" type="TEXT"
                    remarks="Dados do QR Code a imprimir no documento fiscal"/>
        </addColumn>

        <addColumn tableName="invoices">
            <column name="agt_error_message" type="VARCHAR(500)"
                    remarks="Mensagem de erro da AGT em caso de rejeição"/>
        </addColumn>

        <addColumn tableName="invoices">
            <column name="agt_submitted_at" type="TIMESTAMP WITH TIME ZONE"
                    remarks="Data/hora de submissão do documento à API AGT"/>
        </addColumn>

        <!-- Índice para o polling: procurar facturas pendentes eficientemente -->
        <createIndex tableName="invoices" indexName="idx_invoices_agt_status">
            <column name="agt_status"/>
        </createIndex>

        <rollback>
            <dropColumn tableName="invoices" columnName="agt_request_id"/>
            <dropColumn tableName="invoices" columnName="agt_status"/>
            <dropColumn tableName="invoices" columnName="agt_validation_code"/>
            <dropColumn tableName="invoices" columnName="agt_qr_code"/>
            <dropColumn tableName="invoices" columnName="agt_error_message"/>
            <dropColumn tableName="invoices" columnName="agt_submitted_at"/>
        </rollback>
    </changeSet>

</databaseChangeLog>