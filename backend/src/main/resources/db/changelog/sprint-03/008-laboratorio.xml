<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ================================================ -->
    <!-- CHANGESET 1: Tabela lab_tests (catálogo de exames)-->
    <!-- ================================================ -->
    <changeSet id="008-01-criar-tabela-lab-tests" author="hospitalao">
        <createTable tableName="lab_tests">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="hospital_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_lab_tests_hospital"
                             references="hospitals(id)"/>
            </column>
            <column name="code" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="sample_type" type="VARCHAR(50)"/>
            <column name="turnaround_hours" type="INTEGER" defaultValueNumeric="24"/>
            <column name="price" type="NUMERIC(10,2)"/>
            <column name="reference_values" type="TEXT"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="lab_tests"
            columnNames="hospital_id, code"
            constraintName="uq_lab_tests_hospital_code"/>

        <createIndex tableName="lab_tests" indexName="idx_lab_tests_hospital">
            <column name="hospital_id"/>
        </createIndex>

        <rollback><dropTable tableName="lab_tests"/></rollback>
    </changeSet>

    <!-- ================================================ -->
    <!-- CHANGESET 2: Tabela lab_requests                 -->
    <!-- ================================================ -->
    <changeSet id="008-02-criar-tabela-lab-requests" author="hospitalao">
        <createTable tableName="lab_requests">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="hospital_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_lab_requests_hospital"
                             references="hospitals(id)"/>
            </column>
            <column name="episode_id" type="UUID">
                <constraints nullable="true"
                             foreignKeyName="fk_lab_requests_episode"
                             references="episodes(id)"/>
            </column>
            <column name="patient_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_lab_requests_patient"
                             references="patients(id)"/>
            </column>
            <column name="requested_by" type="UUID">
                <constraints nullable="true"
                             foreignKeyName="fk_lab_requests_doctor"
                             references="users(id)"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="priority" type="VARCHAR(10)" defaultValue="NORMAL">
                <constraints nullable="false"/>
            </column>
            <column name="clinical_notes" type="TEXT"/>
            <column name="collected_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="completed_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_by" type="UUID">
                <constraints foreignKeyName="fk_lab_requests_created_by"
                             references="users(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="lab_requests" indexName="idx_lab_requests_patient">
            <column name="patient_id"/>
        </createIndex>
        <createIndex tableName="lab_requests" indexName="idx_lab_requests_hospital">
            <column name="hospital_id"/>
        </createIndex>
        <createIndex tableName="lab_requests" indexName="idx_lab_requests_status">
            <column name="status"/>
        </createIndex>

        <rollback><dropTable tableName="lab_requests"/></rollback>
    </changeSet>

    <!-- ================================================ -->
    <!-- CHANGESET 3: Tabela lab_request_items            -->
    <!-- ================================================ -->
    <changeSet id="008-03-criar-tabela-lab-request-items" author="hospitalao">
        <createTable tableName="lab_request_items">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="request_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_lab_items_request"
                             references="lab_requests(id)"/>
            </column>
            <column name="lab_test_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_lab_items_test"
                             references="lab_tests(id)"/>
            </column>
            <!-- Resultado -->
            <column name="result_value" type="TEXT"/>
            <column name="result_unit" type="VARCHAR(30)"/>
            <column name="reference_range" type="VARCHAR(100)"/>
            <column name="is_abnormal" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="result_notes" type="TEXT"/>
            <column name="resulted_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="resulted_by" type="UUID">
                <constraints foreignKeyName="fk_lab_items_technician"
                             references="users(id)"/>
            </column>
        </createTable>

        <createIndex tableName="lab_request_items" indexName="idx_lab_items_request">
            <column name="request_id"/>
        </createIndex>

        <rollback><dropTable tableName="lab_request_items"/></rollback>
    </changeSet>

</databaseChangeLog>