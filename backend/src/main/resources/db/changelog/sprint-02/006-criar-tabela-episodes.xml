<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ================================================ -->
    <!-- CHANGESET 1: Episode status enum                 -->
    <!-- ================================================ -->
    <changeSet id="006-01-episode-status-enum" author="hospitalao">
        <sql>
            DO $$ BEGIN
                CREATE TYPE episode_status_enum AS ENUM (
                    'SCHEDULED',
                    'IN_PROGRESS',
                    'COMPLETED',
                    'CANCELLED'
                );
            EXCEPTION
                WHEN duplicate_object THEN NULL;
            END $$;
        </sql>
        <rollback>
            <sql>DROP TYPE IF EXISTS episode_status_enum;</sql>
        </rollback>
    </changeSet>

    <!-- ================================================ -->
    <!-- CHANGESET 2: Episodes table                      -->
    <!-- ================================================ -->
    <!--
        episode_type_enum já foi criado no migration 001-schema-base.xml
        Usamos VARCHAR para status e episode_type (em vez de enum nativo
        do Postgres) seguindo a lição aprendida no T-019/T-022 com
        gender_enum: Hibernate @Enumerated(EnumType.STRING) + VARCHAR
        é mais robusto que enum nativo do Postgres.
    -->
    <changeSet id="006-02-criar-tabela-episodes" author="hospitalao">

        <createTable tableName="episodes">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="patient_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_episodes_patient"
                             references="patients(id)"/>
            </column>

            <column name="doctor_id" type="UUID">
                <constraints nullable="true"
                             foreignKeyName="fk_episodes_doctor"
                             references="users(id)"/>
            </column>

            <column name="episode_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="VARCHAR(20)" defaultValue="SCHEDULED">
                <constraints nullable="false"/>
            </column>

            <!-- Scheduling -->
            <column name="scheduled_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="true"/>
            </column>
            <column name="started_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="true"/>
            </column>
            <column name="completed_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="true"/>
            </column>

            <!-- Clinical record -->
            <column name="reason" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>
            <column name="symptoms" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="diagnosis" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="prescription" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="notes" type="TEXT">
                <constraints nullable="true"/>
            </column>

            <!-- Vitals snapshot -->
            <column name="blood_pressure" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
            <column name="heart_rate" type="INTEGER">
                <constraints nullable="true"/>
            </column>
            <column name="temperature" type="NUMERIC(4,1)">
                <constraints nullable="true"/>
            </column>
            <column name="weight_kg" type="NUMERIC(5,2)">
                <constraints nullable="true"/>
            </column>

            <!-- Audit -->
            <column name="created_by" type="UUID">
                <constraints nullable="true"
                             foreignKeyName="fk_episodes_created_by"
                             references="users(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="episodes" indexName="idx_episodes_patient">
            <column name="patient_id"/>
        </createIndex>
        <createIndex tableName="episodes" indexName="idx_episodes_doctor">
            <column name="doctor_id"/>
        </createIndex>
        <createIndex tableName="episodes" indexName="idx_episodes_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="episodes" indexName="idx_episodes_scheduled_at">
            <column name="scheduled_at"/>
        </createIndex>

        <rollback>
            <dropTable tableName="episodes"/>
        </rollback>
    </changeSet>

</databaseChangeLog>