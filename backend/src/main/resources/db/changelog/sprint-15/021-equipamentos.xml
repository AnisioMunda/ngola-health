<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ================================================ -->
    <!-- CHANGESET 1: Equipamentos                        -->
    <!-- ================================================ -->
    <changeSet id="021-01-equipment" author="hospitalao">
        <createTable tableName="equipment">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="hospital_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_equip_hospital"
                             references="hospitals(id)"/>
            </column>
            <column name="name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="brand" type="VARCHAR(100)"/>
            <column name="model" type="VARCHAR(100)"/>
            <column name="serial_number" type="VARCHAR(100)"/>
            <!--
                Categoria:
                DIAGNOSTIC   — imagiologia, laboratório
                THERAPEUTIC  — ventiladores, desfibrilhadores
                SURGICAL     — instrumental cirúrgico
                MONITORING   — monitores de sinais vitais
                MOBILITY     — cadeiras, macas
                IT           — computadores, impressoras
                OTHER
            -->
            <column name="category" type="VARCHAR(20)" defaultValue="OTHER">
                <constraints nullable="false"/>
            </column>
            <column name="location" type="VARCHAR(200)"/>
            <column name="ward_id" type="UUID">
                <constraints nullable="true"
                             foreignKeyName="fk_equip_ward"
                             references="wards(id)"/>
            </column>
            <!--
                Estado:
                ACTIVE       — em uso normal
                MAINTENANCE  — em manutenção
                REPAIR       — em reparação
                RETIRED      — abatido
                RESERVED     — reservado
            -->
            <column name="status" type="VARCHAR(15)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="purchase_date" type="DATE"/>
            <column name="purchase_price" type="DECIMAL(12,2)"/>
            <column name="warranty_expiry" type="DATE"/>
            <!-- Próxima manutenção preventiva -->
            <column name="next_maintenance_date" type="DATE"/>
            <!-- Intervalo de manutenção em dias -->
            <column name="maintenance_interval_days" type="INTEGER" defaultValueNumeric="365"/>
            <!-- Próxima calibração/certificação -->
            <column name="next_calibration_date" type="DATE"/>
            <column name="notes" type="TEXT"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="equipment" indexName="idx_equipment_hospital">
            <column name="hospital_id"/>
            <column name="status"/>
        </createIndex>
        <createIndex tableName="equipment" indexName="idx_equipment_maintenance">
            <column name="hospital_id"/>
            <column name="next_maintenance_date"/>
        </createIndex>

        <rollback><dropTable tableName="equipment"/></rollback>
    </changeSet>

    <!-- ================================================ -->
    <!-- CHANGESET 2: Registos de manutenção              -->
    <!-- ================================================ -->
    <changeSet id="021-02-maintenance" author="hospitalao">
        <createTable tableName="maintenance_records">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="equipment_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_maint_equipment"
                             references="equipment(id)"/>
            </column>
            <!--
                Tipo:
                PREVENTIVE   — manutenção preventiva programada
                CORRECTIVE   — reparação/avaria
                CALIBRATION  — calibração e certificação
                INSPECTION   — inspecção/auditoria
            -->
            <column name="type" type="VARCHAR(15)">
                <constraints nullable="false"/>
            </column>
            <column name="performed_by" type="UUID">
                <constraints nullable="true"
                             foreignKeyName="fk_maint_user"
                             references="users(id)"/>
            </column>
            <column name="performed_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="cost" type="DECIMAL(10,2)"/>
            <column name="next_maintenance_date" type="DATE"/>
            <column name="parts_replaced" type="VARCHAR(500)"/>
            <column name="result" type="VARCHAR(20)" defaultValue="OK"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="maintenance_records"
            indexName="idx_maint_equipment">
            <column name="equipment_id"/>
            <column name="performed_at"/>
        </createIndex>

        <rollback><dropTable tableName="maintenance_records"/></rollback>
    </changeSet>

</databaseChangeLog>