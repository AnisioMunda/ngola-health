root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml,js,ts,html,scss,css,xml}]
indent_style = space
indent_size = 2

[*.{java,sql}]
indent_style = space
indent_size = 4

[*.{sh,bash}]
end_of_line = lf

[Makefile]
indent_style = tab
