# Copiar para .env e preencher localmente. Este ficheiro nao contem segredos.

# PostgreSQL
DB_NAME=
DB_USER=
DB_PASSWORD=

# Segredos da aplicação e serviços internos
# Gerar JWT_SECRET com: openssl rand -base64 32
JWT_SECRET=
REDIS_PASSWORD=
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Senha temporaria do primeiro utilizador da plataforma, codificada em Base64.
# Base64 nao encripta o valor; mantenha-o apenas no .env local.
DEV_ADMIN_INITIAL_PASSWORD_BASE64=

# AGT de produção: injectar credenciais por um gestor de segredos e montar a
# chave privada num ficheiro externo; nunca guardar a chave neste ficheiro.
AGT_CLIENT_ID=
AGT_CLIENT_SECRET=
AGT_PRIVATE_KEY_PATH=
