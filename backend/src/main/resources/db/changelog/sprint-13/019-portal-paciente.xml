<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ================================================ -->
    <!-- CHANGESET 1: Credenciais do portal do paciente   -->
    <!-- ================================================ -->
    <changeSet id="019-01-patient-portal" author="hospitalao">
        <createTable tableName="patient_portal_accounts">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="patient_id" type="UUID">
                <constraints nullable="false" unique="true"
                             foreignKeyName="fk_portal_patient"
                             references="patients(id)"/>
            </column>
            <column name="email" type="VARCHAR(200)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="email_verified" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="last_login_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="patient_portal_accounts"
            indexName="idx_portal_accounts_email">
            <column name="email"/>
        </createIndex>
        <createIndex tableName="patient_portal_accounts"
            indexName="idx_portal_accounts_patient">
            <column name="patient_id"/>
        </createIndex>

        <rollback><dropTable tableName="patient_portal_accounts"/></rollback>
    </changeSet>

    <!-- ================================================ -->
    <!-- CHANGESET 2: Tokens de verificação e reset       -->
    <!-- ================================================ -->
    <changeSet id="019-02-portal-tokens" author="hospitalao">
        <createTable tableName="patient_portal_tokens">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="account_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_portal_token_account"
                             references="patient_portal_accounts(id)"/>
            </column>
            <!--
                Tipo de token:
                EMAIL_VERIFY  — verificação de email
                PASSWORD_RESET — reset de password
            -->
            <column name="token_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="token_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="used_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback><dropTable tableName="patient_portal_tokens"/></rollback>
    </changeSet>

    <!-- ================================================ -->
    <!-- CHANGESET 3: Notificações do portal (SMS/email)  -->
    <!-- ================================================ -->
    <changeSet id="019-03-portal-notifications" author="hospitalao">
        <createTable tableName="patient_notifications">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="patient_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_patient_notif_patient"
                             references="patients(id)"/>
            </column>
            <!--
                Canal: EMAIL, SMS
                Tipo: APPOINTMENT_REMINDER, RESULT_READY,
                      INVOICE_ISSUED, PRESCRIPTION_READY, GENERAL
            -->
            <column name="channel" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="subject" type="VARCHAR(200)"/>
            <column name="body" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="sent" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="sent_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="error_message" type="VARCHAR(500)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="patient_notifications"
            indexName="idx_patient_notif_patient">
            <column name="patient_id"/>
            <column name="sent"/>
        </createIndex>

        <rollback><dropTable tableName="patient_notifications"/></rollback>
    </changeSet>

</databaseChangeLog>