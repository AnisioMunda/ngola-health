<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ================================================ -->
    <!-- CHANGESET 1: Roles table                         -->
    <!-- ================================================ -->
    <changeSet id="002-01-criar-tabela-roles" author="hospitalao">

        <createTable tableName="roles">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_roles_name"/>
            </column>
            <column name="description" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="roles"/>
        </rollback>
    </changeSet>


    <!-- ================================================ -->
    <!-- CHANGESET 2: Permissions table                   -->
    <!-- ================================================ -->
    <changeSet id="002-02-criar-tabela-permissions" author="hospitalao">

        <createTable tableName="permissions">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_permissions_name"/>
            </column>
            <column name="description" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="permissions"/>
        </rollback>
    </changeSet>


    <!-- ================================================ -->
    <!-- CHANGESET 3: Users table                         -->
    <!-- ================================================ -->
    <changeSet id="002-03-criar-tabela-users" author="hospitalao">

        <createTable tableName="users">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="full_name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_users_username"/>
            </column>
            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(200)">
                <constraints nullable="true" unique="true" uniqueConstraintName="uq_users_email"/>
            </column>
            <column name="phone" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
            <column name="especiality" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="professional_card_number" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="register_status" type="VARCHAR(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="must_change_password" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="last_login" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="users" indexName="idx_users_email">
            <column name="email"/>
        </createIndex>

        <createIndex tableName="users" indexName="idx_users_register_status">
            <column name="register_status"/>
        </createIndex>

        <rollback>
            <dropTable tableName="users"/>
        </rollback>
    </changeSet>


    <!-- ================================================ -->
    <!-- CHANGESET 4: User roles junction table           -->
    <!-- ================================================ -->
    <changeSet id="002-04-criar-tabela-user-roles" author="hospitalao">

        <createTable tableName="user_roles">
            <column name="user_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_user_roles_user"
                             references="users(id)"
                             deleteCascade="true"/>
            </column>
            <column name="role_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_user_roles_role"
                             references="roles(id)"
                             deleteCascade="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="user_roles"
                       columnNames="user_id, role_id"
                       constraintName="pk_user_roles"/>

        <rollback>
            <dropTable tableName="user_roles"/>
        </rollback>
    </changeSet>


    <!-- ================================================ -->
    <!-- CHANGESET 5: Role permissions junction table     -->
    <!-- ================================================ -->
    <changeSet id="002-05-criar-tabela-role-permissions" author="hospitalao">

        <createTable tableName="role_permissions">
            <column name="role_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_role_permissions_role"
                             references="roles(id)"
                             deleteCascade="true"/>
            </column>
            <column name="permission_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_role_permissions_permission"
                             references="permissions(id)"
                             deleteCascade="true"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="role_permissions"
                       columnNames="role_id, permission_id"
                       constraintName="pk_role_permissions"/>

        <rollback>
            <dropTable tableName="role_permissions"/>
        </rollback>
    </changeSet>


    <!-- ================================================ -->
    <!-- CHANGESET 6: Initial roles                       -->
    <!-- ================================================ -->
    <changeSet id="002-06-inserir-roles-base" author="hospitalao">

        <insert tableName="roles">
            <column name="id" value="00000000-0000-0000-0000-000000000001"/>
            <column name="name" value="ADMIN"/>
            <column name="description" value="System administrator — full access"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="roles">
            <column name="id" value="00000000-0000-0000-0000-000000000002"/>
            <column name="name" value="DOCTOR"/>
            <column name="description" value="Doctor — consultations, prescriptions, diagnoses"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="roles">
            <column name="id" value="00000000-0000-0000-0000-000000000003"/>
            <column name="name" value="NURSE"/>
            <column name="description" value="Nurse — triage, inpatient, daily evolution"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="roles">
            <column name="id" value="00000000-0000-0000-0000-000000000004"/>
            <column name="name" value="RECEPTIONIST"/>
            <column name="description" value="Receptionist — admission, scheduling, queues"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="roles">
            <column name="id" value="00000000-0000-0000-0000-000000000005"/>
            <column name="name" value="PHARMACIST"/>
            <column name="description" value="Pharmacist — dispensing and medicine stock"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="roles">
            <column name="id" value="00000000-0000-0000-0000-000000000006"/>
            <column name="name" value="FINANCIAL"/>
            <column name="description" value="Financial — billing, payments, reports"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="roles">
            <column name="id" value="00000000-0000-0000-0000-000000000007"/>
            <column name="name" value="MANAGER"/>
            <column name="description" value="Manager — dashboards and reports (read-only)"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="roles">
            <column name="id" value="00000000-0000-0000-0000-000000000008"/>
            <column name="name" value="LAB_TECHNICIAN"/>
            <column name="description" value="Lab Technician — exams and results"/>
            <column name="active" valueBoolean="true"/>
        </insert>

        <rollback>
            <delete tableName="roles">
                <where>id IN (
                    '00000000-0000-0000-0000-000000000001',
                    '00000000-0000-0000-0000-000000000002',
                    '00000000-0000-0000-0000-000000000003',
                    '00000000-0000-0000-0000-000000000004',
                    '00000000-0000-0000-0000-000000000005',
                    '00000000-0000-0000-0000-000000000006',
                    '00000000-0000-0000-0000-000000000007',
                    '00000000-0000-0000-0000-000000000008'
                )</where>
            </delete>
        </rollback>
    </changeSet>
</databaseChangeLog>