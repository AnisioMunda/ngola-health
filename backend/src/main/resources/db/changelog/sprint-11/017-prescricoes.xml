<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ================================================ -->
    <!-- CHANGESET 1: Prescrições                         -->
    <!-- ================================================ -->
    <changeSet id="017-01-prescriptions" author="hospitalao">
        <createTable tableName="prescriptions">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="hospital_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_prescriptions_hospital"
                             references="hospitals(id)"/>
            </column>
            <column name="patient_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_prescriptions_patient"
                             references="patients(id)"/>
            </column>
            <column name="episode_id" type="UUID">
                <constraints nullable="true"
                             foreignKeyName="fk_prescriptions_episode"
                             references="episodes(id)"/>
            </column>
            <column name="admission_id" type="UUID">
                <constraints nullable="true"
                             foreignKeyName="fk_prescriptions_admission"
                             references="admissions(id)"/>
            </column>
            <column name="doctor_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_prescriptions_doctor"
                             references="users(id)"/>
            </column>
            <!--
                Estado:
                ACTIVE    — prescrição activa, aguarda dispensa
                PARTIALLY_DISPENSED — alguns itens dispensados
                DISPENSED — totalmente dispensada
                CANCELLED — cancelada pelo médico
                EXPIRED   — expirou sem ser dispensada
            -->
            <column name="status" type="VARCHAR(25)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="prescription_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <!-- Validade da prescrição (normalmente 30 dias) -->
            <column name="expiry_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="diagnosis" type="VARCHAR(500)"/>
            <column name="notes" type="TEXT"/>
            <!-- Número de prescrição único (ex: RX-2026-00001) -->
            <column name="prescription_number" type="VARCHAR(30)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="cancelled_reason" type="VARCHAR(300)"/>
            <column name="cancelled_by" type="UUID">
                <constraints nullable="true"
                             foreignKeyName="fk_prescriptions_cancelled_by"
                             references="users(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createSequence sequenceName="prescription_number_seq"
            startValue="1" incrementBy="1"/>

        <createIndex tableName="prescriptions" indexName="idx_prescriptions_patient">
            <column name="patient_id"/>
        </createIndex>
        <createIndex tableName="prescriptions" indexName="idx_prescriptions_hospital_date">
            <column name="hospital_id"/>
            <column name="prescription_date"/>
        </createIndex>
        <createIndex tableName="prescriptions" indexName="idx_prescriptions_episode">
            <column name="episode_id"/>
        </createIndex>
        <createIndex tableName="prescriptions" indexName="idx_prescriptions_status">
            <column name="status"/>
        </createIndex>

        <rollback><dropTable tableName="prescriptions"/></rollback>
    </changeSet>

    <!-- ================================================ -->
    <!-- CHANGESET 2: Itens da prescrição                 -->
    <!-- ================================================ -->
    <changeSet id="017-02-prescription-items" author="hospitalao">
        <createTable tableName="prescription_items">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="prescription_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_presc_items_prescription"
                             references="prescriptions(id)"/>
            </column>
            <column name="medication_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_presc_items_medication"
                             references="medications(id)"/>
            </column>
            <!-- Quantidade prescrita -->
            <column name="quantity_prescribed" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <!-- Quantidade já dispensada -->
            <column name="quantity_dispensed" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <!-- Posologia (ex: "1 comprimido 3x ao dia durante 7 dias") -->
            <column name="dosage" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <!-- Frequência em horas (ex: 8 = a cada 8h) -->
            <column name="frequency_hours" type="INTEGER"/>
            <!-- Duração em dias -->
            <column name="duration_days" type="INTEGER"/>
            <!-- Via de administração -->
            <column name="route" type="VARCHAR(50)"/>
            <column name="instructions" type="VARCHAR(300)"/>
            <!--
                Estado do item:
                PENDING    — aguarda dispensa
                DISPENSED  — dispensado
                PARTIAL    — dispensado parcialmente
                CANCELLED  — cancelado
            -->
            <column name="status" type="VARCHAR(15)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="prescription_items" indexName="idx_presc_items_prescription">
            <column name="prescription_id"/>
        </createIndex>
        <createIndex tableName="prescription_items" indexName="idx_presc_items_medication">
            <column name="medication_id"/>
        </createIndex>

        <rollback><dropTable tableName="prescription_items"/></rollback>
    </changeSet>

    <!-- ================================================ -->
    <!-- CHANGESET 3: Registo de dispensas                -->
    <!-- ================================================ -->
    <changeSet id="017-03-dispensations" author="hospitalao">
        <createTable tableName="dispensations">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="prescription_item_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_dispensations_item"
                             references="prescription_items(id)"/>
            </column>
            <column name="medication_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_dispensations_medication"
                             references="medications(id)"/>
            </column>
            <column name="stock_batch_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_dispensations_batch"
                             references="stock_batches(id)"/>
            </column>
            <column name="dispensed_by" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_dispensations_user"
                             references="users(id)"/>
            </column>
            <column name="quantity_dispensed" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="dispensed_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="VARCHAR(300)"/>
        </createTable>

        <createIndex tableName="dispensations" indexName="idx_dispensations_item">
            <column name="prescription_item_id"/>
        </createIndex>
        <createIndex tableName="dispensations" indexName="idx_dispensations_batch">
            <column name="stock_batch_id"/>
        </createIndex>

        <rollback><dropTable tableName="dispensations"/></rollback>
    </changeSet>

</databaseChangeLog>