{
  "name": "hospitalao-frontend",
  "version": "0.0.1",
  "description": "HospitalAO — Sistema de Gestão Hospitalar Angola",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200 --poll 2000",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "api:generate": "swagger-typescript-api generate --path openapi/portal.yaml --output src/app/core/api/generated --name portal-api.ts --no-client --type-only-imports && prettier --write src/app/core/api/generated/portal-api.ts",
    "test": "ng test --watch=false",
    "e2e": "playwright test",
    "test:watch": "ng test --watch=true",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\" angular.json package.json \"tsconfig*.json\" eslint.config.js",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\" angular.json package.json \"tsconfig*.json\" eslint.config.js"
  },
  "dependencies": {
    "@angular/animations": "^22.2.1",
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/entity": "^22.0.1",
    "@ngrx/router-store": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "@ngrx/store-devtools": "^22.0.1",
    "chart.js": "^4.5.1",
    "ng2-charts": "^11.0.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/jasmine": "~7.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.2",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "swagger-typescript-api": "^13.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
