<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ================================================ -->
    <!-- CHANGESET 1: Tabela de notificações              -->
    <!-- ================================================ -->
    <changeSet id="013-01-notifications" author="hospitalao">
        <createTable tableName="notifications">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="hospital_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_notifications_hospital"
                             references="hospitals(id)"/>
            </column>
            <!-- Destinatário (null = todos os utilizadores do hospital) -->
            <column name="user_id" type="UUID">
                <constraints nullable="true"
                             foreignKeyName="fk_notifications_user"
                             references="users(id)"/>
            </column>
            <!--
                Tipos:
                LOW_STOCK       — medicamento com stock baixo
                EXPIRING_STOCK  — lote a expirar em breve
                LAB_RESULT      — resultado de exame disponível
                APPOINTMENT     — lembrete de consulta
                INVOICE_OVERDUE — factura em atraso
                APPOINTMENT_CANCELLED — consulta cancelada
                SYSTEM          — mensagem geral do sistema
            -->
            <column name="type" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <!--
                Prioridade:
                LOW, MEDIUM, HIGH, CRITICAL
            -->
            <column name="priority" type="VARCHAR(10)" defaultValue="MEDIUM">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="message" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <!-- Link para a entidade relacionada (ex: /lab/UUID, /pharmacy/UUID) -->
            <column name="action_url" type="VARCHAR(300)"/>
            <!-- ID da entidade relacionada (ex: UUID da factura) -->
            <column name="reference_id" type="UUID"/>
            <!-- Tipo da entidade (INVOICE, LAB_REQUEST, MEDICATION, APPOINTMENT) -->
            <column name="reference_type" type="VARCHAR(30)"/>
            <!-- Estado de leitura -->
            <column name="read" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="read_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="notifications" indexName="idx_notifications_user_read">
            <column name="user_id"/>
            <column name="read"/>
        </createIndex>
        <createIndex tableName="notifications" indexName="idx_notifications_hospital">
            <column name="hospital_id"/>
            <column name="created_at"/>
        </createIndex>
        <createIndex tableName="notifications" indexName="idx_notifications_type">
            <column name="type"/>
        </createIndex>

        <rollback><dropTable tableName="notifications"/></rollback>
    </changeSet>

</databaseChangeLog>