# Copiar para .env e preencher localmente. Este ficheiro nao contem segredos.

# PostgreSQL
DB_NAME=
DB_USER=
DB_PASSWORD=

# Segredos da aplicação e serviços internos
# Gerar JWT_SECRET com: openssl rand -base64 32
JWT_SECRET=
REDIS_PASSWORD=
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Senha temporaria do primeiro utilizador da plataforma, codificada em Base64.
# Base64 nao encripta o valor; mantenha-o apenas no .env local.
DEV_ADMIN_INITIAL_PASSWORD_BASE64=

# AGT sandbox local. AGT_ENABLED permanece false até existirem credenciais
# autorizadas de homologação. Nunca usar credenciais de produção localmente.
AGT_USERNAME=
AGT_PASSWORD=
AGT_PRIVATE_KEY_PATH=
AGT_NIF=
AGT_SOFTWARE_ID=
AGT_SOFTWARE_VERSION=
AGT_ENABLED=false
AGT_SOFTWARE_VALIDATION=
AGT_TAX_EXEMPTION_CODE=

# Microsoft Teams via Microsoft Graph. The Entra application also needs the
# OnlineMeetings.ReadWrite.All application permission and a scoped application
# access policy for the doctor's organizer accounts.
TEAMS_ENABLED=false
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=

# Apenas para o Compose de produção; o desenvolvimento local usa HTTP localhost.
TLS_DOMAIN=
CERTBOT_EMAIL=

# Backups locais cifrados (opcional; activar o perfil backup para os executar).
# Gere a identidade com `age-keygen`; guarde a chave privada fora do projecto.
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=30
