<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ================================================ -->
    <!-- CHANGESET 1: Sessões de telemedicina             -->
    <!-- ================================================ -->
    <changeSet id="020-01-telemedicine" author="hospitalao">
        <createTable tableName="telemedicine_sessions">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="hospital_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_tele_hospital"
                             references="hospitals(id)"/>
            </column>
            <column name="appointment_id" type="UUID">
                <constraints nullable="true"
                             foreignKeyName="fk_tele_appointment"
                             references="appointments(id)"/>
            </column>
            <column name="patient_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_tele_patient"
                             references="patients(id)"/>
            </column>
            <column name="doctor_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_tele_doctor"
                             references="users(id)"/>
            </column>
            <!--
                Estado:
                SCHEDULED   — agendada
                WAITING     — sala de espera virtual
                IN_PROGRESS — em curso
                COMPLETED   — concluída
                CANCELLED   — cancelada
                NO_SHOW     — paciente não compareceu
            -->
            <column name="status" type="VARCHAR(15)" defaultValue="SCHEDULED">
                <constraints nullable="false"/>
            </column>
            <!-- Token único para acesso à sala -->
            <column name="room_token" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="scheduled_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="started_at"   type="TIMESTAMP WITH TIME ZONE"/>
            <column name="ended_at"     type="TIMESTAMP WITH TIME ZONE"/>
            <!-- Duração em minutos -->
            <column name="duration_minutes" type="INTEGER"/>
            <!-- Notas clínicas durante a videochamada -->
            <column name="clinical_notes" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="telemedicine_sessions"
            indexName="idx_tele_hospital_status">
            <column name="hospital_id"/>
            <column name="status"/>
        </createIndex>
        <createIndex tableName="telemedicine_sessions"
            indexName="idx_tele_patient">
            <column name="patient_id"/>
        </createIndex>
        <createIndex tableName="telemedicine_sessions"
            indexName="idx_tele_doctor_date">
            <column name="doctor_id"/>
            <column name="scheduled_at"/>
        </createIndex>
        <createIndex tableName="telemedicine_sessions"
            indexName="idx_tele_room_token">
            <column name="room_token"/>
        </createIndex>

        <rollback><dropTable tableName="telemedicine_sessions"/></rollback>
    </changeSet>

</databaseChangeLog>