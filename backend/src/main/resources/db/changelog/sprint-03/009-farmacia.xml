<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ================================================ -->
    <!-- CHANGESET 1: Tabela medications (catálogo)       -->
    <!-- ================================================ -->
    <changeSet id="009-01-criar-tabela-medications" author="hospitalao">
        <createTable tableName="medications">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="hospital_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_medications_hospital"
                             references="hospitals(id)"/>
            </column>
            <column name="name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="generic_name" type="VARCHAR(200)"/>
            <column name="dosage_form" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="strength" type="VARCHAR(50)"/>
            <column name="unit" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="requires_prescription" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="min_stock_level" type="INTEGER" defaultValueNumeric="10"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="medications" indexName="idx_medications_hospital">
            <column name="hospital_id"/>
        </createIndex>
        <createIndex tableName="medications" indexName="idx_medications_name">
            <column name="name"/>
        </createIndex>

        <rollback><dropTable tableName="medications"/></rollback>
    </changeSet>

    <!-- ================================================ -->
    <!-- CHANGESET 2: Tabela stock_batches (lotes)        -->
    <!-- ================================================ -->
    <changeSet id="009-02-criar-tabela-stock-batches" author="hospitalao">
        <createTable tableName="stock_batches">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="medication_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_stock_batches_medication"
                             references="medications(id)"/>
            </column>
            <column name="batch_number" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="expiry_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="quantity_received" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="quantity_available" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="unit_cost" type="NUMERIC(10,2)"/>
            <column name="supplier" type="VARCHAR(200)"/>
            <column name="received_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="UUID">
                <constraints foreignKeyName="fk_stock_batches_created_by"
                             references="users(id)"/>
            </column>
        </createTable>

        <createIndex tableName="stock_batches" indexName="idx_stock_batches_medication">
            <column name="medication_id"/>
        </createIndex>
        <createIndex tableName="stock_batches" indexName="idx_stock_batches_expiry">
            <column name="expiry_date"/>
        </createIndex>

        <rollback><dropTable tableName="stock_batches"/></rollback>
    </changeSet>

    <!-- ================================================ -->
    <!-- CHANGESET 3: Tabela stock_movements (auditoria)  -->
    <!-- ================================================ -->
    <changeSet id="009-03-criar-tabela-stock-movements" author="hospitalao">
        <createTable tableName="stock_movements">
            <column name="id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="batch_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_stock_movements_batch"
                             references="stock_batches(id)"/>
            </column>
            <column name="movement_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="patient_id" type="UUID">
                <constraints nullable="true"
                             foreignKeyName="fk_stock_movements_patient"
                             references="patients(id)"/>
            </column>
            <column name="episode_id" type="UUID">
                <constraints nullable="true"
                             foreignKeyName="fk_stock_movements_episode"
                             references="episodes(id)"/>
            </column>
            <column name="reason" type="VARCHAR(500)"/>
            <column name="performed_by" type="UUID">
                <constraints foreignKeyName="fk_stock_movements_user"
                             references="users(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                     defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="stock_movements" indexName="idx_stock_movements_batch">
            <column name="batch_id"/>
        </createIndex>

        <rollback><dropTable tableName="stock_movements"/></rollback>
    </changeSet>

</databaseChangeLog>